# Plantilla del fichero de credenciales de MySQL para FOG Cloning Control.
#
# Pasos de despliegue (fog8 / fog9):
#   1. Copiar este fichero como "fog_cloning_secrets.ini" en este mismo
#      directorio (etc/), rellenando los valores reales.
#   2. Comprobar que "fog_cloning_secrets.ini" (sin ".example") está
#      excluido del control de versiones (.gitignore).
#   3. Restringir su propiedad y permisos al usuario que ejecuta el
#      servicio, por ejemplo:
#        chown <usuario_servicio>:<usuario_servicio> fog_cloning_secrets.ini
#        chmod 600 fog_cloning_secrets.ini
#
# fog_cloning_config.py falla de forma explícita al arrancar si este
# fichero no existe o no tiene el formato esperado.

[mysql]
user = CAMBIAR_USUARIO
password = CAMBIAR_PASSWORD
